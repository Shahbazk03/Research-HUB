{
  "buildCommand": "cd Client && npm install && npm run build && node -e \"const fs=require('fs'); fs.cpSync('dist', '../dist', {recursive: true})\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://research-hub-wp59.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://research-hub-wp59.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
